# The Familia (Mafia) - controller to keyboard/mouse via PortMaster gptokeyb.
# The game reads only this keyboard/mouse; it does not open the controller.
# Keys follow the game's default keyboard layout (Options > Controls).
#
# On foot: left stick/d-pad move, right stick look/aim, R2 fire, L2 aim mode,
#          A action/use, B jump, X reload, Y crouch, L1/R1 previous/next weapon
#          (inventory), Select map, Start pause menu, L3 run toggle.
# Driving: left stick steer + accelerate/brake, B handbrake, R1 horn,
#          A exit car, X speed limiter, Y look back.
# Menus:   d-pad/left stick move, A enter, Start/B-in-menu esc.
start = esc
back = tab
a = enter
b = space
x = r
y = c
l1 = q
r1 = e
l3 = leftshift
r3 = h
up = up
down = down
left = left
right = right
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
r2 = mouse_left
l2 = mouse_right
